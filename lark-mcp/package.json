{
  "name": "lark-mcp",
  "version": "0.1.0",
  "description": "MCP server for reading Lark (Feishu) group chat history",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "test": "tsc && node --test \"dist/__tests__/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "bin": {
    "lark-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ]
}
