# Credentials from the Lark/Feishu developer console (App → Credentials & Basic Info)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "larksuite" for the international edition (open.larksuite.com),
# "feishu" for the China edition (open.feishu.cn). Default: larksuite
LARK_DOMAIN=larksuite

# Time zone used when rendering and parsing message timestamps. Default: Asia/Tokyo
LARK_TIME_ZONE=Asia/Tokyo

# --- HTTP transport only (npm run start:http) ---
# Port to listen on. Default: 3000
PORT=3000
# Shared secret required in the Authorization: Bearer header. Strongly recommended
# when the server is reachable from the internet.
MCP_AUTH_TOKEN=
